{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/flyarchos/logo.txt"
  },
  "display": {
    "colors": {
      "keys": "cyan",
      "title": "magenta"
    },
    "separator": "  → "
  },
  "modules": [
    { "type": "title", "format": "{3}@{4}" },
    { "type": "separator" },
    "host",
    "kernel",
    "uptime",
    { "type": "packages", "format": "{/pacman} (pacman), {/flatpak} (flatpak)" },
    "shell",
    { "type": "de", "format": "{2}" },
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    { "type": "locale" },
    "break",
    "colors"
  ]
}
