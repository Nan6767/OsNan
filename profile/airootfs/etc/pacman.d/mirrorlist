# FlyArchOs — стартовые зеркала Arch Linux.
# Пакетный /etc/pacman.d/mirrorlist из pacman-mirrorlist по умолчанию
# полностью закомментирован, и свежая система не смогла бы обновляться.
# Geo-зеркало само выбирает близкий сервер; остальные — запасные.
# Свои быстрые зеркала: sudo flyarchos-update --mirrors
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
