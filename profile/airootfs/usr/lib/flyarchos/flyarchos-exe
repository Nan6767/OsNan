#!/usr/bin/env bash
# flyarchos-exe — Windows-программы (.exe/.msi) в FlyArchOs через Wine.
#
# FlyArchOs ставит Wine в игровом наборе полного образа; в остальных
# вариантах `setup` сам предложит доустановить пакеты через pacman.
# Все Windows-программы живут в отдельном префиксе Wine:
#   ~/.local/share/flyarchos/wineprefix  (переменная FLYARCHOS_WINEPREFIX)
#
#   flyarchos-exe                      статус и справка
#   flyarchos-exe setup [--yes]        подготовить окружение (Wine, префикс,
#                                      шрифты Windows и DXVK для игр)
#   flyarchos-exe run <файл.exe>       запустить .exe/.msi (это же делает
#                                      двойной клик в файловом менеджере)
#   flyarchos-exe install <setup.exe>  установить Windows-программу
#   flyarchos-exe list                 что уже установлено
#   flyarchos-exe shortcut <файл.exe>  ярлык в меню приложений (иконка
#                                      вытаскивается из самого .exe)
#   flyarchos-exe config               настройки Wine (winecfg)
#   flyarchos-exe uninstall            удаление установленных программ
#   flyarchos-exe kill                 остановить зависшие процессы Wine
#
# «Бутылки» — отдельные окружения Wine под разные программы и игры
# (свои настройки, свои установленные программы, удаляется целиком):
#   flyarchos-exe bottle                 список бутылок
#   flyarchos-exe bottle create <имя>    новая бутылка
#   flyarchos-exe bottle remove <имя>    удалить бутылку целиком
#   flyarchos-exe --bottle <имя> run …   любая команда в выбранной бутылке
#                                        (или переменная FLYARCHOS_WINE_BOTTLE)
#
# Для игр из Steam удобнее Proton внутри Steam; flyarchos-exe — про
# обычные программы и отдельные .exe «с флешки».

set -uo pipefail

PREFIX="${FLYARCHOS_WINEPREFIX:-$HOME/.local/share/flyarchos/wineprefix}"
export WINEPREFIX="$PREFIX"
export WINEARCH=win64
# Тихий Wine по умолчанию; FLYARCHOS_WINE_DEBUG=1 — вернуть болтовню в лог.
[ "${FLYARCHOS_WINE_DEBUG:-0}" = "1" ] || export WINEDEBUG="${WINEDEBUG:--all}"

STATE_DIR="$HOME/.local/state/flyarchos"
BOTTLES_DIR="${FLYARCHOS_BOTTLES_DIR:-$HOME/.local/share/flyarchos/bottles}"
WINE_PKGS="wine wine-mono wine-gecko winetricks icoutils cabextract"

say()  { printf '%s\n' "$*"; }
warn() { printf 'flyarchos-exe: %s\n' "$*" >&2; }

have_wine()    { command -v wine >/dev/null 2>&1; }
prefix_ready() { [ -f "$PREFIX/system.reg" ]; }

usage() {
    cat <<'EOF'
Использование:
  flyarchos-exe setup [--yes]        подготовить окружение Wine
  flyarchos-exe run <файл.exe>       запустить .exe или установщик .msi
  flyarchos-exe install <setup.exe>  установить Windows-программу
  flyarchos-exe list                 установленные Windows-программы
  flyarchos-exe shortcut <файл.exe>  ярлык в меню (с иконкой из .exe)
  flyarchos-exe config               настройки Wine (winecfg)
  flyarchos-exe uninstall            удалить установленную программу
  flyarchos-exe kill                 остановить процессы Wine
  flyarchos-exe bottle [list]        бутылки: отдельные окружения Wine
  flyarchos-exe bottle create <имя>  новая бутылка (под игру/программу)
  flyarchos-exe bottle remove <имя>  удалить бутылку целиком
  flyarchos-exe --bottle <имя> …     выполнить команду в выбранной бутылке
EOF
}

# Запуск не из терминала (двойной клик), а Wine нет: открыть терминал с setup.
open_terminal_setup() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a FlyArchOs "Wine не установлен" \
            "Открою терминал — там одна команда всё поставит." || true
    fi
    local t
    for t in kitty konsole xterm; do
        if command -v "$t" >/dev/null 2>&1; then
            if [ -n "${BOTTLE:-}" ]; then
                exec "$t" -e "$0" --bottle "$BOTTLE" setup
            else
                exec "$t" -e "$0" setup
            fi
        fi
    done
    return 1
}

install_wine_pkgs() {
    say "Wine не установлен. Понадобятся пакеты: $WINE_PKGS"
    say "(репозиторий multilib в FlyArchOs уже включён)"
    if [ "${1:-}" != "--yes" ]; then
        printf 'Установить сейчас через pacman? [Y/n] '
        read -r ans || ans=n
        case "$ans" in
            ""|y|Y|yes|Yes|д|Д) : ;;
            *) say "Отменено. Позже в любой момент: flyarchos-exe setup"; return 1 ;;
        esac
    fi
    # shellcheck disable=SC2086
    sudo pacman -S --needed $WINE_PKGS
}

# Вернуть 0, если wine есть (или только что поставили).
ensure_wine() {
    have_wine && return 0
    [ -t 0 ] || { open_terminal_setup; return 1; }
    install_wine_pkgs "${1:-}" && have_wine
}

init_prefix() {
    prefix_ready && return 0
    say "Создаю окружение Wine: $PREFIX"
    mkdir -p "$PREFIX" "$STATE_DIR"
    wineboot --init >>"$STATE_DIR/wine-setup.log" 2>&1
    wineserver -w 2>/dev/null || true
    prefix_ready
}

# Необязательные компоненты: шрифты Windows и DXVK для игр (нужен интернет).
# $1 = --yes: без вопроса.
setup_components() {
    local yes="${1:-}"
    command -v winetricks >/dev/null 2>&1 || return 0
    local tricks=1 ans
    if [ -z "$yes" ]; then
        printf 'Поставить шрифты Windows и DXVK для игр? (нужен интернет) [Y/n] '
        read -r ans || ans=n
        case "$ans" in ""|y|Y|yes|Yes|д|Д) : ;; *) tricks=0 ;; esac
    fi
    [ "$tricks" = "1" ] || return 0
    say "winetricks: corefonts…"
    if winetricks -q corefonts >>"$STATE_DIR/wine-setup.log" 2>&1; then
        say "  шрифты готовы"
    else
        warn "  corefonts не поставились (сеть?) — лог: $STATE_DIR/wine-setup.log"
    fi
    say "winetricks: dxvk (DirectX 9–11 через Vulkan, для игр)…"
    if winetricks -q dxvk >>"$STATE_DIR/wine-setup.log" 2>&1; then
        say "  DXVK готов"
    else
        warn "  DXVK не поставился (сеть?) — программы пойдут и так, играм будет медленнее"
    fi
}


cmd_setup() {
    local yes=""
    case "${1:-}" in --yes|-y) yes="--yes" ;; esac
    ensure_wine "$yes" || return 1
    if ! init_prefix; then
        warn "не удалось создать префикс, подробности: $STATE_DIR/wine-setup.log"
        return 1
    fi
    say "Wine: $(wine --version 2>/dev/null); префикс готов."
    setup_components "$yes"
    say "Готово! Дальше:"
    say "  · двойной клик по .exe в файловом менеджере — запуск"
    say "  · flyarchos-exe install <установщик.exe> — поставить программу"
    say "  · flyarchos-exe list — что установлено"
}

run_file() {
    local file="${1:-}"
    [ $# -gt 0 ] && shift
    if [ -z "$file" ] || [ ! -f "$file" ]; then
        warn "файл не найден: ${file:-<не задан>}"
        return 1
    fi
    ensure_wine || return 1
    init_prefix || return 1
    mkdir -p "$STATE_DIR"
    local dir
    dir="$(dirname -- "$file")"
    file="$(realpath -- "$file")"
    say "Запускаю через Wine: $(basename -- "$file") (лог: $STATE_DIR/wine-last.log)"
    case "${file,,}" in
        *.msi) (cd "$dir" && wine msiexec /i "$file" "$@") >>"$STATE_DIR/wine-last.log" 2>&1 ;;
        *.exe) (cd "$dir" && wine "$file" "$@") >>"$STATE_DIR/wine-last.log" 2>&1 ;;
        *) warn "это не .exe и не .msi: $file"; return 2 ;;
    esac
}

cmd_install() {
    local file="${1:-}"
    [ -n "$file" ] || { warn "нужен установщик: flyarchos-exe install <setup.exe>"; return 2; }
    say "Устанавливаю Windows-программу (префикс: $PREFIX)"
    run_file "$@"
    local rc=$?
    if [ "$rc" = "0" ]; then
        say "Если установка прошла, программа появится в: flyarchos-exe list"
        say "Ярлык в меню: flyarchos-exe shortcut <путь к .exe установленной программы>"
    fi
    return "$rc"
}

list_programs() {
    local roots=()
    [ -d "$PREFIX/drive_c/Program Files" ] && roots+=("$PREFIX/drive_c/Program Files")
    [ -d "$PREFIX/drive_c/Program Files (x86)" ] && roots+=("$PREFIX/drive_c/Program Files (x86)")
    [ "${#roots[@]}" -gt 0 ] || return 0
    find "${roots[@]}" -maxdepth 3 -type f -iname '*.exe' \
        ! -iname 'uninst*.exe' ! -iname 'unins*.exe' 2>/dev/null | sort
}

cmd_list() {
    if ! prefix_ready; then
        say "Окружение Wine ещё не создано. Подготовить: flyarchos-exe setup"
        return 0
    fi
    local progs
    progs="$(list_programs)"
    if [ -z "$progs" ]; then
        say "Windows-программ пока не установлено."
        say "Поставить: flyarchos-exe install <установщик.exe>"
        return 0
    fi
    say "Установленные Windows-программы ($PREFIX):"
    printf '%s\n' "$progs" | while IFS= read -r p; do
        printf '  %-28s %s\n' "$(basename -- "$p")" "$p"
    done
    say "Запуск: flyarchos-exe run <путь> · Ярлык: flyarchos-exe shortcut <путь>"
}

cmd_shortcut() {
    local file="${1:-}"
    if [ -z "$file" ] || [ ! -f "$file" ]; then
        warn "нужен существующий .exe: flyarchos-exe shortcut <файл.exe>"
        return 2
    fi
    file="$(realpath -- "$file")"
    local name slug
    name="$(basename -- "$file")"
    name="${name%.*}"
    slug="$(printf '%s' "$name" | tr -cs 'A-Za-z0-9' '-' | tr 'A-Z' 'a-z' | sed 's/^-*//; s/-*$//')"
    [ -n "$slug" ] || slug="program"

    local icon="wine"
    if command -v wrestool >/dev/null 2>&1 && command -v icotool >/dev/null 2>&1; then
        local tmp; tmp="$(mktemp -d)"
        if wrestool -x -t 14 -o "$tmp/icon.ico" "$file" >/dev/null 2>&1 \
           && icotool -x -o "$tmp" "$tmp/icon.ico" >/dev/null 2>&1; then
            local png
            png="$(ls -S "$tmp"/*.png 2>/dev/null | head -n1 || true)"
            if [ -n "$png" ] && [ -f "$png" ]; then
                local icondir="$HOME/.local/share/icons/hicolor/256x256/apps"
                mkdir -p "$icondir"
                cp -f "$png" "$icondir/flyarchos-wine-$slug.png"
                icon="flyarchos-wine-$slug"
            fi
        fi
        rm -rf "$tmp"
    fi

    local appdir="$HOME/.local/share/applications"
    mkdir -p "$appdir"
    local desktop="$appdir/flyarchos-wine-$slug.desktop"
    cat > "$desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$name (Wine)
Comment=Windows-программа через Wine (FlyArchOs)
Exec=flyarchos-exe ${BOTTLE:+--bottle $BOTTLE }run "$file"
Icon=$icon
Terminal=false
Categories=Utility;
EOF
    command -v update-desktop-database >/dev/null 2>&1 \
        && update-desktop-database "$appdir" >/dev/null 2>&1 || true
    say "Ярлык создан: $desktop (ищите «$name (Wine)» в меню приложений)"
}

# --- «бутылки»: отдельные окружения Wine -----------------------------------

valid_bottle_name() {
    case "${1:-}" in
        ""|.|..) return 1 ;;
        *[!A-Za-z0-9._-]*) return 1 ;;
        *) return 0 ;;
    esac
}

# Путь префикса бутылки по имени (default — обычное окружение FlyArchOs).
bottle_path() {
    if [ "${1:-default}" = "default" ]; then
        printf '%s' "${FLYARCHOS_WINEPREFIX:-$HOME/.local/share/flyarchos/wineprefix}"
    else
        printf '%s/%s' "$BOTTLES_DIR" "$1"
    fi
}

bottle_state() {
    if [ -f "$1/system.reg" ]; then
        printf 'готов, %s' "$(du -sh "$1" 2>/dev/null | cut -f1)"
    else
        printf 'не создан'
    fi
}

list_bottles() {
    local p d
    p="$(bottle_path default)"
    printf '  %-16s %s (%s)
' "default" "$p" "$(bottle_state "$p")"
    if [ -d "$BOTTLES_DIR" ]; then
        for d in "$BOTTLES_DIR"/*/; do
            [ -d "$d" ] || continue
            printf '  %-16s %s (%s)
' "$(basename "$d")" "${d%/}" "$(bottle_state "${d%/}")"
        done
    fi
}

cmd_bottle() {
    local sub="${1:-list}"
    [ $# -gt 0 ] && shift
    case "$sub" in
        list)
            say "Бутылки Wine (текущая: ${BOTTLE:-default}):"
            list_bottles
            say "Создать: flyarchos-exe bottle create <имя>"
            say "Использовать: flyarchos-exe --bottle <имя> <команда>"
            ;;
        create)
            local name="${1:-}" yes=""
            case "${2:-}" in --yes|-y) yes="--yes" ;; esac
            if [ "$name" = "default" ]; then
                warn "бутылка default — основное окружение; готовится командой: flyarchos-exe setup"
                return 2
            fi
            if ! valid_bottle_name "$name"; then
                warn "недопустимое имя бутылки: '${name:-<не задано>}' (разрешены буквы, цифры, . _ -)"
                return 2
            fi
            PREFIX="$(bottle_path "$name")"
            export WINEPREFIX="$PREFIX"
            BOTTLE="$name"
            if prefix_ready; then
                say "Бутылка '$name' уже существует: $PREFIX"
                return 0
            fi
            ensure_wine "$yes" || return 1
            mkdir -p "$BOTTLES_DIR"
            init_prefix || { warn "не удалось создать бутылку, подробности: $STATE_DIR/wine-setup.log"; return 1; }
            say "Бутылка '$name' создана: $PREFIX"
            setup_components "$yes"
            say "Дальше: flyarchos-exe --bottle $name install <setup.exe>"
            ;;
        remove)
            local name="${1:-}" ans path
            if [ "$name" = "default" ]; then
                warn "default этой командой не удаляю (основное окружение). Вручную: rm -rf "$(bottle_path default)""
                return 2
            fi
            if ! valid_bottle_name "$name"; then
                warn "недопустимое имя бутылки: '${name:-<не задано>}'"
                return 2
            fi
            path="$(bottle_path "$name")"
            [ -d "$path" ] || { warn "бутылки '$name' нет"; return 1; }
            if [ "${2:-}" != "--yes" ]; then
                printf 'Удалить бутылку %s (%s) целиком? [y/N] ' "$name" "$path"
                read -r ans || ans=n
                case "$ans" in
                    y|Y|yes|Yes|д|Д) : ;;
                    *) say "Отменено."; return 0 ;;
                esac
            fi
            if command -v wineserver >/dev/null 2>&1; then
                WINEPREFIX="$path" wineserver -k 2>/dev/null || true
            fi
            rm -rf "$path"
            say "Бутылка '$name' удалена."
            ;;
        *)
            warn "неизвестная подкоманда bottle: $sub (доступно: list, create, remove)"
            return 2
            ;;
    esac
}


status() {
    say "FlyArchOs — Windows-программы (.exe/.msi) через Wine"
    if have_wine; then
        say "  Wine:    $(wine --version 2>/dev/null)"
    else
        say "  Wine:    не установлен — flyarchos-exe setup поставит всё нужное"
    fi
    say "  Бутылка: ${BOTTLE:-default} (flyarchos-exe bottle — список и создание)"
    if prefix_ready; then
        say "  Префикс: $PREFIX (готов, $(du -sh "$PREFIX" 2>/dev/null | cut -f1))"
        say "  Программ установлено: $(list_programs | grep -c . || true)"
    else
        say "  Префикс: $PREFIX (ещё не создан)"
    fi
    say
    usage
}

# Глобальная опция --bottle <имя> (или переменная FLYARCHOS_WINE_BOTTLE):
# выполнить команду в отдельном окружении Wine.
BOTTLE="${FLYARCHOS_WINE_BOTTLE:-}"
while [ $# -gt 0 ]; do
    case "$1" in
        --bottle|-b) BOTTLE="${2:-}"; shift 2 ;;
        --bottle=*)  BOTTLE="${1#--bottle=}"; shift ;;
        *) break ;;
    esac
done
if [ -n "$BOTTLE" ]; then
    if ! valid_bottle_name "$BOTTLE"; then
        warn "недопустимое имя бутылки: '$BOTTLE' (разрешены буквы, цифры, . _ -)"
        exit 2
    fi
    PREFIX="$(bottle_path "$BOTTLE")"
    export WINEPREFIX="$PREFIX"
fi

ACTION="${1:-status}"
[ $# -gt 0 ] && shift

# Удобство: flyarchos-exe путь/к/файлу.exe — сразу запуск.
case "$ACTION" in
    *.exe|*.EXE|*.msi|*.MSI) run_file "$ACTION" "$@"; exit $? ;;
esac

case "$ACTION" in
    setup)     cmd_setup "$@" ;;
    run)       [ $# -ge 1 ] || { warn "нужен файл: flyarchos-exe run <файл.exe>"; exit 2; }
               run_file "$@" ;;
    install)   cmd_install "$@" ;;
    list)      cmd_list ;;
    shortcut)  cmd_shortcut "$@" ;;
    config)    ensure_wine && init_prefix && exec winecfg ;;
    uninstall) ensure_wine && init_prefix && exec wine uninstaller ;;
    kill)      if command -v wineserver >/dev/null 2>&1; then
                   wineserver -k && say "Процессы Wine остановлены."
               else
                   warn "Wine не установлен — останавливать нечего."
                   exit 1
               fi ;;
    bottle)    cmd_bottle "$@" ;;
    status|-h|--help) status ;;
    *) warn "неизвестное действие: $ACTION"; usage >&2; exit 2 ;;
esac
