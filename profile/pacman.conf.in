#
# /etc/pacman.conf — конфигурация pacman для СБОРКИ образа FlyArchOs
# (шаблон: scripts/build-iso.sh подставляет пути и создаёт profile/pacman.conf).
#
# Отличается от системного /etc/pacman.conf только включённым multilib
# и, опционально, локальным репозиторием с пакетами AUR.
#
# ВАЖНО: метка-заполнитель FLYARCHOS_REPO (в конце файла) должна
# встречаться ровно ОДИН раз и стоять одна в строке — build-iso.sh
# заменяет каждое вхождение секцией [flyarchos] целиком, а дубль секции
# даёт «could not register 'flyarchos' database» в логе pacstrap.

[options]
HoldPkg      = pacman glibc
Architecture = auto
CheckSpace
SigLevel     = Required DatabaseOptional
LocalFileSigLevel = Optional
ParallelDownloads = 8

[core]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist

# 32-битные библиотеки (Steam, Wine, драйверы)
[multilib]
Include = /etc/pacman.d/mirrorlist

# Локальный репозиторий с собранными AUR-пакетами (make aur).
# Если репозиторий не собран, строка закомментирована.
@FLYARCHOS_REPO@
